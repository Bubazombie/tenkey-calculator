{
  "name": "tenkey-calculator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "frontend",
    "e2e"
  ],
  "scripts": {
    "coverage": "node scripts/coverage.mjs",
    "check": "npm run lint:backend && npm run test:backend && npm run typecheck:frontend && npm run lint:frontend && npm run test:frontend && npm run test:hooks",
    "lint:backend": "cd backend && golangci-lint run",
    "test:backend": "cd backend && go test ./...",
    "typecheck:frontend": "npm run typecheck --workspace frontend",
    "lint:frontend": "npm run lint --workspace frontend",
    "test:frontend": "npm run test --workspace frontend",
    "test:e2e": "npm run test --workspace e2e",
    "test:hooks": "node --test .githooks/commit-msg.test.mjs"
  }
}
